# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/foundit

# Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_change_in_production
ALLOWED_EMAIL_DOMAIN=yourcollege.edu.in

# Cloudinary (Optional in development - fallback local storage used if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Matching & Expiry Settings
ITEM_EXPIRY_DAYS=60
MATCH_MIN_SCORE=0.45

# Optional Redis for Queue
REDIS_URL=
